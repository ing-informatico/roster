# API
VITE_API_BASE_URL=http://localhost:5014

# Cognito (reemplazar con los valores del User Pool de su organizacion)
VITE_COGNITO_AUTHORITY=https://cognito-idp.<region>.amazonaws.com/<user-pool-id>
VITE_COGNITO_CLIENT_ID=<app-client-id>
VITE_COGNITO_REDIRECT_URI=http://localhost:5173
VITE_COGNITO_SCOPE=email openid phone
VITE_COGNITO_DOMAIN=<your-domain>.auth.<region>.amazoncognito.com
